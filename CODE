# ----------------------------- WEB SERVER -----------------------------
def api_json():
    dashboard["uptime"] = uptime()
    dashboard["wifi"] = wlan.isconnected()
    dashboard["rssi"] = safe_rssi()
    return json.dumps(dashboard)

def send_bytes(connection, data):
    position = 0

    while position < len(data):
        sent = connection.send(data[position:])

        if sent is None or sent <= 0:
            raise OSError("Socket closed during send")

        position += sent

async def web_server_task():
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("", 80))
    server.listen(3)
    server.setblocking(False)

    print("Dashboard ready at", dashboard_url())

    while True:
        connection = None

        try:
            connection, _ = server.accept()
            connection.settimeout(1)

            request = connection.recv(512).decode("utf-8", "ignore")
            is_api = request.startswith("GET /api")

            body = api_json() if is_api else build_html()
            content_type = "application/json" if is_api else "text/html; charset=utf-8"

            payload = body.encode("utf-8")
            header = (
                "HTTP/1.1 200 OK\r\n"
                "Content-Type: %s\r\n"
                "Cache-Control: no-store\r\n"
                "Content-Length: %d\r\n"
                "Connection: close\r\n\r\n"
                % (content_type, len(payload))
            ).encode()

            send_bytes(connection, header)
            send_bytes(connection, payload)

        except OSError:
            pass

        except Exception as error:
            print("Web server error:", error)

        finally:
            if connection:
                try:
                    connection.close()
                except Exception:
                    pass

        await asyncio.sleep_ms(25)

# ----------------------------- MONITOR TASK ---------------------------
async def monitor_task():
    baseline = 0
    warm_samples = []

    pending = 0
    dht_errors = 0
    status = "WARMUP"

    last_wifi_retry = 0
    last_telemetry = time.ticks_ms()

    while True:
        now = time.ticks_ms()

        if not wlan.isconnected():
            if time.ticks_diff(now, last_wifi_retry) >= 10000:
                last_wifi_retry = now
                wifi_connect()

        try:
            dht_sensor.measure()
            temp = dht_sensor.temperature()
            hum = dht_sensor.humidity()

            dht_errors = 0
            sensor_ok = True

        except OSError:
            dht_errors += 1
            temp = None
            hum = None
            sensor_ok = dht_errors < 3

        gas_raw = read_gas()

        warming = time.ticks_diff(now, start_ms) < MQ2_WARMUP_S * 1000

        if warming:
            warm_samples = (warm_samples + [gas_raw])[-10:]
            gas_rise = 0
        else:
            if baseline == 0:
                baseline = sum(warm_samples) // max(1, len(warm_samples))
                print("MQ2 baseline:", baseline)

            gas_rise = max(0, gas_raw - baseline)

        vibration = read_simulated_vibration(temp)

        if temp is None:
            candidate = "NORMAL"
        else:
            candidate = classify(temp, gas_rise, vibration)

        if not sensor_ok and candidate == "NORMAL":
            candidate = "SENSOR_FAULT"

        if warming and candidate == "NORMAL":
            candidate = "WARMUP"

        # Critical is immediate. Other state changes need two readings.
        if candidate == status:
            pending = 0

        elif candidate == "CRITICAL" or status == "WARMUP":
            status = candidate
            pending = 0

        else:
            pending += 1

            if pending >= NORMAL_CONFIRM_READS:
                status = candidate
                pending = 0

        dashboard.update({
            "status": status,
            "reason": status_reason(temp, gas_rise, vibration, status),
            "temp": temp,
            "hum": hum,
            "vib": vibration,
            "vib_source": "SIMULATED",
            "gas_raw": gas_raw,
            "gas_rise": gas_rise,
            "gas_baseline": baseline,
            "sensor_ok": sensor_ok,
            "wifi": wlan.isconnected(),
            "ip": wlan.ifconfig()[0] if wlan.isconnected() else "--",
            "rssi": safe_rssi(),
            "uptime": uptime(),
            "last_updated": uptime()
        })

        drive_outputs(status, now)

        print(
            "T=%s H=%s V=%.3f(SIM) gas=%d(+%d) => %s"
            % (temp, hum, vibration, gas_raw, gas_rise, status)
        )

        maybe_alert(now)

        if time.ticks_diff(now, last_telemetry) >= TELEMETRY_INTERVAL_S * 1000:
            last_telemetry = now
            tg_send(snapshot_message("30-SECOND LIVE READING"))

        await asyncio.sleep_ms(READ_MS)

# ------------------------------- START --------------------------------
async def main():
    print("Starting", DEVICE_NAME, "with simulated vibration")

    wifi_connect()

    if wlan.isconnected():
        tg_send("%s is online.\nDashboard:\n%s" % (DEVICE_NAME, dashboard_url()))

    await asyncio.gather(
        monitor_task(),
        web_server_task()
    )

asyncio.run(main())
