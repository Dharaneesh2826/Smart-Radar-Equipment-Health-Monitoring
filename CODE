# =====================================================================
# Smart Radar Enclosure Monitor — ESP32 MicroPython
# DHT22/DHT11 + MQ2 gas sensor + simulated vibration for demonstration
# Dashboard hosted by ESP32 — no Flask, OLED, or MPU6050 required
# =====================================================================

import network, socket, json, time, dht, gc, random
import uasyncio as asyncio
from machine import Pin, ADC

try:
    import urequests as requests
except ImportError:
    import requests

# ------------------------------ SETTINGS ------------------------------
WIFI_SSID = "XXXX"
WIFI_PASSWORD = "XXXX"
TG_TOKEN = "XXXX"
TG_CHAT_ID = "XXXX"

PUBLIC_DASHBOARD_URL = ""
DEVICE_NAME = "Radar Enclosure Monitor"
SENSOR_TYPE = "DHT22"

TELEMETRY_INTERVAL_S = 30
ALERT_REPEAT_S = 300
READ_MS = 2000
MQ2_WARMUP_S = 30
NORMAL_CONFIRM_READS = 2

TEMP_WARN = 20
TEMP_CRIT = 60.0
VIB_WARN = 0.10
VIB_CRIT = 0.50
GAS_DELTA_CRIT = 500

# DHT data, MQ2 analogue, buzzer, green LED, red LED
PIN_DHT, PIN_MQ2, PIN_BUZZER, PIN_GREEN, PIN_RED = 4, 34, 25, 26, 27

# ------------------------------ HARDWARE ------------------------------
green = Pin(PIN_GREEN, Pin.OUT, value=0)
red = Pin(PIN_RED, Pin.OUT, value=0)
buzzer = Pin(PIN_BUZZER, Pin.OUT, value=0)

mq2 = ADC(Pin(PIN_MQ2))
mq2.atten(ADC.ATTN_11DB)

if SENSOR_TYPE == "DHT11":
    dht_sensor = dht.DHT11(Pin(PIN_DHT))
else:
    dht_sensor = dht.DHT22(Pin(PIN_DHT))

wlan = network.WLAN(network.STA_IF)
start_ms = time.ticks_ms()

dashboard = {
    "device": DEVICE_NAME,
    "status": "WARMUP",
    "reason": "MQ2 baseline warming up",
    "temp": None,
    "hum": None,
    "vib": 0.0,
    "vib_source": "SIMULATED",
    "gas_raw": 0,
    "gas_rise": 0,
    "gas_baseline": 0,
    "sensor_ok": True,
    "wifi": False,
    "ip": "--",
    "rssi": None,
    "uptime": "00:00:00",
    "last_updated": "Waiting for first sample"
}

# ------------------------------- HELPERS ------------------------------
def uptime():
    seconds = time.ticks_diff(time.ticks_ms(), start_ms) // 1000
    return "%02d:%02d:%02d" % (
        seconds // 3600,
        (seconds % 3600) // 60,
        seconds % 60
    )

def safe_rssi():
    try:
        return wlan.status("rssi") if wlan.isconnected() else None
    except Exception:
        return None

def dashboard_url():
    if PUBLIC_DASHBOARD_URL.strip():
        return PUBLIC_DASHBOARD_URL.strip()
    return "http://%s" % dashboard["ip"]

# ---------------------------- WIFI CONNECTION -------------------------
def wifi_connect():
    if wlan.isconnected():
        dashboard["wifi"] = True
        dashboard["ip"] = wlan.ifconfig()[0]
        return True

    # Fixes ESP32 "Wifi Internal State Error" after a soft reboot.
    for attempt in range(1, 4):
        try:
            wlan.active(False)
        except Exception:
            pass

        time.sleep_ms(500)

        try:
            wlan.active(True)
            time.sleep_ms(500)

            try:
                wlan.disconnect()
            except Exception:
                pass

            wlan.connect(WIFI_SSID, WIFI_PASSWORD)

            started = time.ticks_ms()
            while not wlan.isconnected():
                if time.ticks_diff(time.ticks_ms(), started) > 12000:
                    break
                time.sleep_ms(250)

            if wlan.isconnected():
                dashboard["wifi"] = True
                dashboard["ip"] = wlan.ifconfig()[0]
                print("Wi-Fi connected:", dashboard["ip"])
                return True

            print("Wi-Fi attempt %d timed out" % attempt)

        except Exception as error:
            print("Wi-Fi attempt %d failed: %s" % (attempt, error))

    dashboard["wifi"] = False
    dashboard["ip"] = "--"
    return False

# ------------------------------ SENSORS -------------------------------
def read_gas():
    total = 0

    for _ in range(16):
        total += mq2.read()
        time.sleep_ms(2)

    return total // 16

def random_noise():
    try:
        return (random.getrandbits(12) / 4095.0 - 0.5) * 0.012
    except AttributeError:
        return ((time.ticks_ms() % 1000) / 1000.0 - 0.5) * 0.012

def read_simulated_vibration(temp):
    # Demo-only value — not a physical vibration measurement.
    if temp is None:
        return 0.0

    if temp >= TEMP_WARN:
        span = max(1.0, TEMP_CRIT - TEMP_WARN)
        progress = min(1.0, (temp - TEMP_WARN) / span)

        # Above warning level at 40 C; above critical near 60 C.
        vibration = VIB_WARN + 0.015
        vibration += progress * (VIB_CRIT - VIB_WARN + 0.040)
    else:
        vibration = 0.015

    return max(0.0, vibration + random_noise())

# ----------------------------- STATE LOGIC ----------------------------
def classify(temp, gas_rise, vibration):
    if gas_rise >= GAS_DELTA_CRIT:
        return "CRITICAL"

    if temp >= TEMP_CRIT or vibration >= VIB_CRIT:
        return "CRITICAL"

    if temp >= TEMP_WARN or vibration >= VIB_WARN:
        return "DEGRADED"

    return "NORMAL"

def status_reason(temp, gas_rise, vibration, status):
    if status == "WARMUP":
        return "MQ2 baseline warming up"

    if status == "SENSOR_FAULT":
        return "DHT sensor read failure"

    reasons = []

    if gas_rise >= GAS_DELTA_CRIT:
        reasons.append("gas increase")

    if temp is not None and temp >= TEMP_CRIT:
        reasons.append("critical temperature")
    elif temp is not None and temp >= TEMP_WARN:
        reasons.append("high temperature")

    if vibration >= VIB_CRIT:
        reasons.append("critical simulated vibration")
    elif vibration >= VIB_WARN:
        reasons.append("simulated vibration")

    if reasons:
        return ", ".join(reasons)

    return "all readings are within limits"

def drive_outputs(status, now):
    if status == "NORMAL":
        green.value(1)
        red.value(0)
        buzzer.value(0)

    elif status == "DEGRADED":
        green.value(0)
        red.value(1)
        buzzer.value(1)

    elif status == "CRITICAL":
        on = (now // 100) % 2 == 0
        green.value(0)
        red.value(on)
        buzzer.value(on)

    elif status == "WARMUP":
        on = (now // 500) % 2 == 0
        green.value(on)
        red.value(on)
        buzzer.value(0)

    else:
        green.value(0)
        red.value(1)
        buzzer.value(0)

# ------------------------------ TELEGRAM ------------------------------
last_tg_failure = None
alert_rank = 0
last_alert_ms = 0

RANK = {
    "NORMAL": 0,
    "WARMUP": 0,
    "DEGRADED": 1,
    "SENSOR_FAULT": 1,
    "CRITICAL": 2
}

def url_encode(value):
    encoded = []

    for byte in str(value).encode("utf-8"):
        char = chr(byte)

        if (char.isalpha() and byte < 128) or char.isdigit() or char in "-_.~":
            encoded.append(char)
        else:
            encoded.append("%%%02X" % byte)

    return "".join(encoded)

def telegram_ready():
    return (
        wlan.isconnected()
        and TG_TOKEN
        and TG_CHAT_ID
        and "YOUR_" not in TG_TOKEN
        and "YOUR_" not in TG_CHAT_ID
    )

def tg_send(message):
    global last_tg_failure

    if not telegram_ready():
        return False

    if last_tg_failure is not None:
        if time.ticks_diff(time.ticks_ms(), last_tg_failure) < 20000:
            return False

    url = (
        "https://api.telegram.org/bot%s/sendMessage?chat_id=%s&text=%s"
        % (TG_TOKEN, url_encode(TG_CHAT_ID), url_encode(message))
    )

    response = None

    try:
        gc.collect()
        response = requests.get(url)

        if response.status_code == 200:
            last_tg_failure = None
            return True

        print("Telegram error:", response.status_code)

    except Exception as error:
        print("Telegram send failed:", error)

    finally:
        if response:
            try:
                response.close()
            except Exception:
                pass

        gc.collect()

    last_tg_failure = time.ticks_ms()
    return False

def snapshot_message(prefix="LIVE READING"):
    s = dashboard

    temperature = "--" if s["temp"] is None else "%.1f C" % s["temp"]
    humidity = "--" if s["hum"] is None else "%d %%" % s["hum"]

    return (
        "%s\n%s: %s\nReason: %s\n\n"
        "Temperature: %s\n"
        "Humidity: %s\n"
        "Vibration: %.3f g [SIMULATED]\n"
        "Gas sensor: %d (rise +%d)\n\n"
        "Dashboard:\n%s"
        % (
            prefix,
            DEVICE_NAME,
            s["status"],
            s["reason"],
            temperature,
            humidity,
            s["vib"],
            s["gas_raw"],
            s["gas_rise"],
            dashboard_url()
        )
    )

def maybe_alert(now):
    global alert_rank, last_alert_ms

    status = dashboard["status"]
    rank = RANK.get(status, 0)

    if status == "WARMUP":
        return

    if rank > alert_rank:
        if tg_send(snapshot_message("ALERT")):
            alert_rank = rank
            last_alert_ms = now

    elif rank > 0 and rank == alert_rank:
        if time.ticks_diff(now, last_alert_ms) >= ALERT_REPEAT_S * 1000:
            if tg_send(snapshot_message("ALERT STILL ACTIVE")):
                last_alert_ms = now

    elif 0 < rank < alert_rank:
        alert_rank = rank

    elif rank == 0 and alert_rank > 0:
        if tg_send(snapshot_message("RECOVERED")):
            alert_rank = 0

